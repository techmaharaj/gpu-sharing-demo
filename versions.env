# Pinned versions for the GPU sharing demo, checked 2026-10-16. The manifests in k8s/ carry the same image
# digests (change both together). Tested on k3s v1.35.9+k3s1: HAMi's kube-scheduler image must match your
# cluster's Kubernetes version, so on another version change KUBE_VERSION and hami-values.yaml (hami.sh checks).
KUBE_VERSION=v1.35.9
# NVIDIA device plugin (without HAMi: whole GPU per pod)
DEVICE_PLUGIN_IMAGE=nvcr.io/nvidia/k8s-device-plugin:v0.20.1@sha256:27c1b2553a690ca3d29889dcd61df97525d46f58272c0be8dc63c2b18f120075
# llama.cpp server, CUDA 12.8.1 build (CUDA 12, not 13: HAMi-core's CUDA 13 support isn't released yet)
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda12-b11515@sha256:ccfd96bb2aba4ef77e3df656d713ce85bf3c6a886d7974243127c5ad66ca6d2a
# HAMi v2.10.0: chart from the HAMi Helm repo, checked against its index digest; images by digest
HELM_VERSION=v3.22.1
HELM_SHA256=896cf63684a42a723d61c980369d6e588330927deb13676ca0d85006dd6da0ea
HAMI_CHART_URL=https://Project-HAMi.github.io/HAMi/charts/hami-2.10.0.tgz
HAMI_CHART_SHA256=e1d8429b2270da1a5c26343d6d6fd2a0099ba7b944cf0f52eb20d6b9f14e5099
# Image pod: stable-diffusion.cpp sd-server, CUDA 12.6 build. Upstream publishes only the moving tag master-cuda,
# so this digest is the pin (master-968-8cd731e era, pulled 2026-10-16). k8s/image.yaml carries the same digest.
SD_IMAGE=ghcr.io/leejet/stable-diffusion.cpp:master-cuda@sha256:834bfb16c7f2443c3bb3186d3add311ef4653b996bab4a9a04e9fb9e756f3076
